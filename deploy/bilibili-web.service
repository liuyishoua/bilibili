[Unit]
Description=bilibili workspace
After=network.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/leo-project/bilibili
ExecStart=/home/ubuntu/leo-project/bilibili/.venv/bin/python -m web --port 8773 --public-origin https://d.58nft.net:9451
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
